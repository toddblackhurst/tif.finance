# Supabase — copy from your Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Only needed for server-side admin operations (keep secret, never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App URL used in auth redirects and email links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend email
RESEND_API_KEY=your-resend-api-key
RESEND_FROM="TIF Finance <finance@example.org>"

# Finance notification recipients
TREASURER_EMAIL=treasurer@example.org
PAYMENT_NOTIFICATION_EMAILS=summer@example.org,finance@example.org
DAILY_SUMMARY_EMAIL=finance-summary@example.org
